{
  "name": "ft-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mkdir -p ./public/keys ./public/zkir && cp -r ../contract/managed/facetoken/keys/* ./public/keys/ && cp -r ../contract/managed/facetoken/zkir/* ./public/zkir/ && vite",
