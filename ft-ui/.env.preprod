# Network the dApp asks the wallet to connect to.
VITE_NETWORK_ID=preprod

# Used for the read-only ledger table, which renders before anyone connects.
# Every other endpoint (indexer websocket, proof server) is read from the
# wallet's own getConfiguration() so the dApp always follows the wallet.
VITE_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql

# Optional. Set this to a deployed contract address so visitors can mint
# straight away instead of deploying their own.
VITE_DEFAULT_CONTRACT=
