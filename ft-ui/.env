# Network the dApp asks the wallet to connect to. This MUST match the network
# selected in the wallet extension, or the connection is refused and the
# bech32m shielded keys fail to decode.
VITE_NETWORK_ID=preprod

# Used for the read-only ledger table, which renders before anyone connects.
# The indexer websocket and the proof server are read from the wallet's own
# getConfiguration() so the dApp always follows the wallet.
VITE_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql

# The live contract. Because this is set, visitors mint against it directly and
# the deploy and switch controls stay hidden. It must be deployed on the network
# named above; a contract from another network will not resolve.
VITE_DEFAULT_CONTRACT=3a8fc78ee9b41dc21834376469f13bae7982cda925e1d8b191bc5cca883691b9
