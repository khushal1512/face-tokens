# Network the dApp asks the wallet to connect to.
# preview is sponsored: 1AM covers fees and proves through its ProofStation, so
# users need no NIGHT, no DUST and no local proof server.
VITE_NETWORK_ID=preview

# Used for the read-only ledger table, which renders before anyone connects.
# The indexer websocket and the proof server are read from the wallet's own
# getConfiguration() so the dApp always follows the wallet.
VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql

# Optional. Set this to a contract deployed on the SAME network as above so
# visitors can mint straight away instead of deploying their own. A preprod
# address will not resolve on preview.
VITE_DEFAULT_CONTRACT=
